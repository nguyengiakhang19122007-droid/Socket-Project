# ============================================================
# Cấu hình Gateway Server (Role 2 - Huy)
# Copy file này thành .env và điền các giá trị thực tế
# ============================================================

# ── Gateway Network ──────────────────────────────────────────
# Địa chỉ lắng nghe (0.0.0.0 = chấp nhận từ toàn bộ LAN)
GATEWAY_HOST=0.0.0.0

# Cổng WebSocket (phải mở trong Windows Firewall)
GATEWAY_PORT=8765

# ── Authentication Token ─────────────────────────────────────
# Token bí mật dùng để xác thực Web App.
# Chạy: python gateway_server.py --generate-token
# để tạo token ngẫu nhiên an toàn.
# Token này phải khớp giữa gateway_server.py và Web App (frontend).
GATEWAY_TOKEN=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ── Streaming Settings ────────────────────────────────────────
# Số frame/giây cho Screen livestream (khuyến nghị: 5-10)
SCREEN_FPS=5

# Số frame/giây cho Webcam livestream (khuyến nghị: 10-15)
WEBCAM_FPS=10

# ── Agent (dùng trong agent_main.py) ─────────────────────────
# URL của Gateway mà Agent sẽ kết nối đến (loopback vì cùng máy)
WINDOWS_AGENT_GATEWAY_URL=ws://127.0.0.1:8765

# Token mà Agent dùng để kết nối Gateway (phải khớp GATEWAY_TOKEN)
WINDOWS_AGENT_GATEWAY_TOKEN=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ── Logging ───────────────────────────────────────────────────
# DEBUG = in chi tiết (tốt khi phát triển)
# INFO  = thông tin bình thường
# WARNING = chỉ in cảnh báo
LOG_LEVEL=INFO
